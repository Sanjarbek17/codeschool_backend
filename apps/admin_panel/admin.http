###
# CodeSchool Backend API - Admin Panel Testing
# This file contains test requests for admin registration functionality
# Updated with admin_notes feature for student management
# Base URL: http://localhost:8000
###

### Variables
# @baseUrl = http://localhost:8000
@baseUrl = https://sanjar1718.pythonanywhere.com/
# @adminToken = 08221832adcbbf71de627ce705bece788edd86c3
@adminToken = 07d420ed5f2afd603521dbff7e1ee32a502f0f39

###
# STEP 1: ADMIN LOGIN
# Admin logs in to get authentication token
POST {{baseUrl}}/api/login/
Content-Type: application/json

{
    "username": "admin",
    "password": "admin"
}

###
# STEP 2: REGISTER NEW STUDENT
# Admin registers a new student with auto-generated credentials
POST {{baseUrl}}/api/admin-panel/register/student/
Content-Type: application/json
Authorization: Token {{adminToken}}

{
    "first_name": "Alice",
    "last_name": "Johnson",
    "phone_number": "+1234567890",
    "parents_phone_number": "+1234567899",
    "admin_notes": "New student from transfer school. Strong in mathematics, needs support in English writing.",
    "groups": ["16"]
}

###
# STEP 2.1: REGISTER NEW STUDENT WITH ADMIN NOTES
# Admin registers a new student with admin notes (internal use only)
POST {{baseUrl}}/api/admin-panel/register/student/
Content-Type: application/json
Authorization: Token {{adminToken}}

{
    "first_name": "Charlie",
    "last_name": "Brown",
    "phone_number": "+1555123456",
    "parents_phone_number": "+1555123457",
    "admin_notes": "Student has dyslexia - needs extra time for reading assignments. Parent contacted about accommodations.",
    "groups": []
}

###
# STEP 3: REGISTER NEW TEACHER
# Admin registers a new teacher with auto-generated credentials
POST {{baseUrl}}/api/admin-panel/register/teacher/
Content-Type: application/json
Authorization: Token {{adminToken}}

{
    "email": "testteacher@example.com",
    "first_name": "Bob",
    "last_name": "Wilson",
    "phone_number": "+1987654321"
}

###
# STEP 4: GET ALL STUDENTS (Admin View)
# Admin views all students - includes admin_notes field
GET {{baseUrl}}/api/admin-panel/students/
Authorization: Token {{adminToken}}

###
# STEP 5: UPDATE STUDENT ADMIN NOTES
# Admin updates admin notes for a specific student
# Replace {student_id} with actual student ID from previous responses
PATCH {{baseUrl}}/api/admin-panel/students/{student_id}/
Content-Type: application/json
Authorization: Token {{adminToken}}

{
    "admin_notes": "Updated notes: Student showing significant improvement in math. Consider advanced placement next semester."
}

###
# STEP 6: SEARCH STUDENTS WITH FILTERS
# Admin searches for students (admin_notes included in response)
GET {{baseUrl}}/api/admin-panel/students/?search=Alice
Authorization: Token {{adminToken}}